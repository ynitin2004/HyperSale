# Copy to `.env` and fill in the five values marked FILL IN. Everything else has a
# working default.
#
# `.env` is gitignored. This file is committed, so it must never hold a real key,
# password, or project ref.
#
# Every variable below is read by the code today. Variables the code does not read
# have been removed: adding one back does nothing until an adapter reads it.

# =========================================================
# 1. DATABASE  — FILL IN
# =========================================================
# Supabase dashboard -> Connect -> Transaction pooler (port 6543).
# Change `postgresql://` to `postgresql+asyncpg://` or the app cannot open it.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Local alternative, via `docker compose up -d db`:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hypersale

# Migrations need the SESSION pooler (port 5432) — DDL does not belong on the
# transaction pooler. alembic/env.py reads DATABASE_URL, so pass it inline:
#   DATABASE_URL='<session-pooler-url>' alembic upgrade head

# =========================================================
# 2. AUTH  — FILL IN one of the two
# =========================================================
# Authentication fails closed until one is set; the verifier refuses to guess.
# New Supabase projects sign asymmetrically — set the JWKS URL, leave the secret blank.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Legacy projects only — set this instead and leave the JWKS URL blank.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# =========================================================
# 3. VOICE  — FILL IN both
# =========================================================
# D21 moved voice to Azure Speech Voice Live, but the CODE still mints OpenAI tokens
# until the VoiceProvider adapter lands. Until then these stay required: the session
# endpoint refuses to mint unless BOTH are set.
OPENAI_API_KEY=
# Any random string you invent. Hashes the user id before it reaches the provider.
OPENAI_SAFETY_IDENTIFIER_SALT=

# =========================================================
# 4. OPTIONAL — defaults shown; set only to override
# =========================================================
APP_ENV=development

# Must be unique per running worker. Two workers sharing an id will requeue and
# rerun each other's jobs.
WORKER_ID=worker-local

# Leave at 0 until a real session measures them. Zero is recorded as `rate_missing`,
# so an unmeasured rate reads as unknown rather than as free.
REALTIME_AUDIO_INPUT_MICROUSD_PER_MINUTE=0
REALTIME_AUDIO_OUTPUT_MICROUSD_PER_MINUTE=0

# Both inert until set, and both also need `pip install '.[telemetry]'`.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Browser. The SPA falls back to http://localhost:8000 when unset.
VITE_API_BASE_URL=http://localhost:8000

# Integration tests only. Must be a THROWAWAY database — the fixtures run CREATE ROLE
# and delete the workspaces they create. Never point this at your Supabase project.
# Unset skips the integration tests silently.
TEST_DATABASE_URL=

# =========================================================
# 5. NOT READ BY ANY CODE YET
# =========================================================
# Planned providers, listed so you know what to obtain. Setting a key here changes
# nothing until its adapter exists. Delete the line if you drop the provider.

# Voice (D21). Region is load-bearing: centralindia measured ~2 s, a US region ~5 s.
AZURE_VOICE_LIVE_ENDPOINT=
AZURE_VOICE_LIVE_API_KEY=
AZURE_VOICE_LIVE_REGION=centralindia
AZURE_VOICE_LIVE_MODEL=gpt-realtime

# Scoring and reports.
ANTHROPIC_API_KEY=

# Transcription with diarization, M3 only.
DEEPGRAM_API_KEY=
