# Template only. Copy to `.env` and fill in real values there.
# `.env` is gitignored; this file is committed and pushed, so it must never hold a
# real key, password, or project ref.

# ==========================================
# APP
# ==========================================
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=hypersale-api

# ==========================================
# DATABASE
# ==========================================
# Both URLs must use the `+asyncpg` driver. SQLAlchemy's async engine cannot open a
# plain `postgresql://` URL, and Alembic now runs async through the same driver.
# Copying a URL straight from the Supabase dashboard will fail until you add `+asyncpg`.

# Transaction pooler, port 6543 — the running API and worker.
# Already pooler-safe: the engine sets statement_cache_size=0, and tenant GUCs go
# through set_config(..., true) inside an explicit transaction rather than SET LOCAL.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Local alternative, via `docker compose up -d db`:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hypersale

# Session pooler, port 5432 — Alembic migrations only. DDL belongs on a session-mode
# connection, not the transaction pooler.
# NOT YET READ BY THE CODE: alembic/env.py still uses DATABASE_URL. Until that one-line
# change lands, pass this inline instead:
#   DATABASE_URL='<session-mode-url>' alembic upgrade head
ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# The worker's queue dispatcher is the only cross-tenant component, so it connects as
# its own least-privilege role. Blank means "reuse DATABASE_URL".
# NOT YET READ BY THE CODE: pending the BYPASSRLS vs role-scoped-policy decision.
WORKER_DATABASE_URL=

# ==========================================
# SUPABASE
# ==========================================
SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (`sb_publishable_…`) is the new name for the anon key and is safe in
# the browser. Server-side copy is optional; the browser reads VITE_ below.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (`sb_secret_…`) replaces the service_role key. Server-side ONLY — it
# bypasses RLS entirely. Never give it a VITE_ prefix and never paste it anywhere
# shared. Used only to mint short-lived signed Storage URLs.
SUPABASE_SECRET_KEY=

# Private bucket for chunked session recordings (M1).
SUPABASE_STORAGE_BUCKET=recordings

# ==========================================
# JWT AUTHENTICATION
# ==========================================
# Authentication fails closed until one of these is set.
# New Supabase projects sign asymmetrically: set the JWKS URL, leave the secret blank.
# Legacy projects use a shared HS256 secret: set the secret, leave the JWKS URL blank.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=

# ==========================================
# VOICE PROVIDER
# ==========================================
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_SAFETY_IDENTIFIER_SALT=replace-me

# Leave at 0 until a real session measures them. Zero is recorded as `rate_missing`,
# so an unmeasured rate shows up as unknown rather than as free.
REALTIME_AUDIO_INPUT_MICROUSD_PER_MINUTE=0
REALTIME_AUDIO_OUTPUT_MICROUSD_PER_MINUTE=0

# ==========================================
# WORKER AND JOB QUEUE
# ==========================================
WORKER_ID=worker-local
WORKER_BATCH_SIZE=5
WORKER_POLL_SECONDS=1.0
WORKER_STALL_SECONDS=120
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_SECONDS=5
JOB_BACKOFF_MAX_SECONDS=900

# ==========================================
# OBSERVABILITY
# ==========================================
# Both are inert until set, and also require `pip install '.[telemetry]'`.
# Without them the app still emits structured JSON logs.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ==========================================
# BROWSER (VITE_ prefix reaches the client bundle)
# ==========================================
# Anything here is public. Never put a provider key or the Supabase secret key here.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# ==========================================
# TESTS
# ==========================================
# Integration tests only. Must be a THROWAWAY database — the fixtures run CREATE ROLE
# and delete the workspaces they create. Never point this at your Supabase project.
# Unset skips the integration tests silently.
TEST_DATABASE_URL=
