# Browser-exposed values must use the VITE_ prefix. Never put provider keys here.
VITE_API_BASE_URL=http://localhost:8000

APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=hypersale-api
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hypersale

# Authentication fails closed until one of these is set.
# New Supabase projects sign asymmetrically; set the JWKS URL and leave the secret blank.
# Legacy projects use a shared HS256 secret; set the secret and leave the JWKS URL blank.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=

OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_SAFETY_IDENTIFIER_SALT=replace-me

# Leave at 0 until a real session measures them. Zero is recorded as `rate_missing`,
# so an unmeasured rate shows up as unknown rather than as free.
REALTIME_AUDIO_INPUT_MICROUSD_PER_MINUTE=0
REALTIME_AUDIO_OUTPUT_MICROUSD_PER_MINUTE=0

WORKER_ID=worker-local
WORKER_BATCH_SIZE=5
WORKER_POLL_SECONDS=1.0
WORKER_STALL_SECONDS=120
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_SECONDS=5
JOB_BACKOFF_MAX_SECONDS=900

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Integration tests only. Superuser URL for a throwaway database; unset skips those tests.
TEST_DATABASE_URL=
